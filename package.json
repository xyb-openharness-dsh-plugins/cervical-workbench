{
  "name": "@xyb-community/cervical-workbench",
  "version": "0.1.3",
  "description": "本机优先的宫颈癌FIGO分期、生育保留、根治性放化疗与长期副作用、复诊准备工作台",
  "private": true,
  "type": "module",
  "main": "./dsh/index.js",
  "exports": {
    ".": "./dsh/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "dsh",
    "lib",
    "public",
    "demo/build-demo-data.mjs",
    "schema",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "NOTICE.md",
    "LICENSE"
  ],
  "scripts": {
    "build:demo": "node --disable-warning=ExperimentalWarning demo/build-demo-data.mjs",
    "build:version": "node scripts/build-version.mjs",
    "build:client": "node scripts/build-client.mjs",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check:schema": "node scripts/check-schema.mjs",
    "check:wording": "node scripts/check-wording.mjs",
    "check:columns": "node scripts/check-demo-columns.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.mjs",
    "check": "node scripts/build-version.mjs && node --disable-warning=ExperimentalWarning demo/build-demo-data.mjs && node scripts/check-version.mjs && node scripts/check-syntax.mjs && node scripts/check-schema.mjs && node scripts/check-wording.mjs && node scripts/check-demo-columns.mjs && node scripts/build-client.mjs --check && node --disable-warning=ExperimentalWarning --test test/*.test.mjs && node scripts/check-workbench-package.mjs . && node scripts/check-primer-links.mjs",
    "pack:check": "npm pack --dry-run",
    "start": "node --disable-warning=ExperimentalWarning scripts/dev-server.mjs",
    "dev": "node --disable-warning=ExperimentalWarning scripts/dev-server.mjs",
    "check:install": "node scripts/check-install.mjs",
    "check:version": "node scripts/check-version.mjs",
    "check:pack": "node --disable-warning=ExperimentalWarning scripts/check-pack.mjs",
    "release:pack": "node scripts/build-client.mjs && node scripts/build-version.mjs && npm pack --pack-destination release",
    "probe:primer": "node scripts/probe-disease-primer.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-desktop-workbenches"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xyb-openharness-dsh-plugins/cervical-workbench"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5",
    "@deepseek-ai/dsh-client-connection": ">=0.1.0-rc.0 <0.3.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.0 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.1 <4"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
